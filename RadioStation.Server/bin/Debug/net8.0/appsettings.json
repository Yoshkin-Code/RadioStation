{
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:4686"
      }
    },
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Prometheus": {
    "ExposeThreadPoolMetrics": true,
    "ExposeGCMetrics": true,
    "ExposeJitMetrics": false,
    "ExposeContentionMetrics": true,
    "ExposeExeptionStats": false,
    "UseKestrel": true,
    "Host": "localhost",
    "Port": 9000
  },
  "NLog": {
    //for enabling debugging of nlog config   
    //"throwConfigExceptions": true,
    "targets": {
      "coloredconsole": {
        "type": "ColoredConsole",
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "loggersource",
              "layout": "${logger}"
            },
            {
              "name": "timestamp",
              "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss.fff}"
            },
            {
              "name": "loglevel",
              "layout": "${level}"
            },
            {
              "name": "message",
              "layout": "${message}"
            },
            {
              "name": "error",
              "layout": "${exception:format=ToString}"
            },
            {
              "name": "app_name",
              "layout": "${environment:APP_NAME}"
            }
          ]
        }
      }
    },
    "rules": {  
      "0": {
        "logger": "System.*",
        "finalMinLevel": "Warn"
      },
      "1": {
        "logger": "Microsoft.*",
        "finalMinLevel": "Warn"
      },
      "2": {
        "logger": "Microsoft.Hosting.Lifetime*",
        "finalMinLevel": "Info"
        //Overrides Microsoft.* rule
      },
      "3": {
        "logger": "Grpc.*",
        "finalMinLevel": "Warn"
      },
      "99": {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "coloredconsole"
      }
    }
  }
}
